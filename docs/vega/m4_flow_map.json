                  30,
                  260
                ]
              },
              "legend": null
            },
            "color": {
              "field": "dest",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "Australia",
                  "Elsewhere"
                ],
                "range": [
                  "#B07A00",
                  "#9B9A94"
                ]
              }
            },
            "opacity": {
              "condition": {
                "test": "focus == '' || datum.target_code == focus || datum.any_lit == 0",
                "value": 1
              },
              "value": 0.15
            },
            "tooltip": [
              {
                "field": "target",
                "type": "nominal",
                "title": "Reprinted in"
              },
              {
                "field": "reprints",
                "type": "quantitative",
                "title": "US stories reprinted",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.target_code == focus || (zoomBase * zoomK >= 6 ? true : zoomBase * zoomK >= 2 ? datum.reprints >= 2000 : indexof(['fr','no','br','mx','ca'], datum.target_code) >= 0)"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "dy": -9,
            "color": "#2B2B28",
            "clip": true
          },
          "encoding": {
            "latitude": {
              "field": "tlat",
              "type": "quantitative"
            },
            "longitude": {
              "field": "tlon",
              "type": "quantitative"
            },
            "text": {
              "field": "target"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "zoomBase * zoomK < 2"
            },
            {
              "filter": "datum.target_code == 'au'"
            },
            {
              "calculate": "'Australia: ' + format(datum.reprints, ',') + ' US stories'",
              "as": "lab"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "dy": 40,
            "color": "#2B2B28",
            "fontWeight": "bold",
            "align": "left",
            "dx": -30,
            "clip": true
          },
          "encoding": {
            "latitude": {
              "field": "tlat",
              "type": "quantitative"
            },
            "longitude": {
              "field": "tlon",
              "type": "quantitative"
            },
            "text": {
              "field": "lab"
            }
          }
        }

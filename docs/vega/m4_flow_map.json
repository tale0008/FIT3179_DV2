        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) != 10"
        },
        {
          "filter": "datum.id == '036' || datum.id == 36 || datum.id == '840' || datum.id == 840"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "toNumber(datum.id) == 36",
            "value": "#DDC17F"
          },
          "value": "#93A8D1"
        }
      }

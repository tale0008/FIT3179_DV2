{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where America's comics went (to 2026)",
    "subtitle": [
      "Stories first published in the United States and reprinted elsewhere.",
      "Line width shows the number of reprinted stories. Flows of 1,000 or more."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "zoom",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": [
          "World",
          "Europe"
        ],
        "name": "Zoom to "
      }
    },
    {
      "name": "focus",
      "value": ""
    },
    {
      "name": "zoomBase",
      "expr": "zoom == 'Europe' ? 3.3 : 1"
    },
    {
      "name": "zoomCentre",
      "expr": "zoom == 'Europe' ? [110, 53] : [0, 28]"
    },
    {
      "name": "zoomUnit",
      "expr": "width / (2 * PI)"
    },
    {
      "name": "zoomK",
      "value": 1
    },
    {
      "name": "panX",
      "value": 0
    },
    {
      "name": "panY",
      "value": 0
    }
  ],
  "width": "container",
  "height": 460,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator",
    "rotate": [
      100,
      0,
      0
    ],
    "scale": {
      "expr": "zoomBase * zoomK * zoomUnit"
    },
    "center": {
      "expr": "zoomCentre"
    },
    "translate": {
      "expr": "[width / 2 + panX, height / 2 + panY]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E3EDF3",
        "strokeWidth": 0,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ECEBE6",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "clip": true
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) != 10"
        },
        {
          "calculate": "toNumber(datum.id)",
          "as": "iso_n3"
        },
        {
          "lookup": "iso_n3",
          "from": {
            "data": {
              "url": "data/country_meta.csv"
            },
            "key": "iso_n3",
            "fields": [
              "code",
              "country"
            ]
          }
        }
      ]
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) != 10"
        },
        {
          "filter": "datum.id == '036' || datum.id == 36 || datum.id == '840' || datum.id == 840"
        },
        {
          "calculate": "toNumber(datum.id) == 36 ? 'au' : 'us'",
          "as": "code"
        },
        {
          "calculate": "datum.code == 'au' ? 'Australia' : 'United States'",
          "as": "country"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "clip": true
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "toNumber(datum.id) == 36",
            "value": "#DDC17F"
          },
          "value": "#93A8D1"
        }
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "iso_n3"
        },
        {
          "lookup": "iso_n3",
          "from": {
            "data": {
              "url": "data/country_meta.csv"
            },
            "key": "iso_n3",
            "fields": [
              "code"
            ]
          }
        },
        {
          "filter": "focus != '' && datum.code == focus"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "filled": false,
        "stroke": "#00B4D8",
        "strokeWidth": 2,
        "strokeJoin": "round",
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/reprint_flows.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "trim(lower(datum.origin_code || datum['\\ufefforigin_code'] || ''))",
          "as": "o"
        },
        {
          "calculate": "trim(lower(datum.target_code || ''))",
          "as": "t"
        },
        {
          "calculate": "toNumber(replace(datum.reprints + '', ',', ''))",
          "as": "n"
        },
        {
          "filter": "datum.o == 'us' && datum.n >= 1000"
        },

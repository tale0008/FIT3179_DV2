    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ECEBE6",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "transform": [
        {
          "filter": "toNumber(datum.id) != 10"
        }
      ]
    },
    {

              "field": "olat",
              "type": "quantitative"
            },
            "longitude": {
              "field": "olon",
              "type": "quantitative"
            },
            "latitude2": {
              "field": "tlat"
            },
            "longitude2": {
              "field": "tlon"
            },
            "strokeWidth": {
              "field": "reprints",
              "type": "quantitative",
              "scale": {
                "range": [
                  1,
                  12
                ]
              },
              "legend": null
            },
            "color": {
              "field": "dest",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "Australia",
                  "Elsewhere"
                ],
                "range": [
                  "#B07A00",
                  "#9B9A94"
                ]
              }
            },
            "order": {
              "condition": {
                "test": "datum.target_code == 'au'",
                "value": 1
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "target",
                "type": "nominal",
                "title": "Reprinted in"
              },
              {
                "field": "reprints",
                "type": "quantitative",
                "title": "US stories reprinted",
                "format": ","
              }
            ],
            "opacity": {
              "condition": {
                "test": "focus == '' || datum.target_code == focus || datum.any_lit == 0",
                "value": 0.85
              },
              "value": 0.15
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "triangle-right",
            "filled": true,
            "clip": true
          },
          "encoding": {
            "latitude": {
              "field": "tlat",
              "type": "quantitative"
            },
            "longitude": {
              "field": "tlon",
              "type": "quantitative"
            },
            "angle": {
              "field": "heading",
              "type": "quantitative",

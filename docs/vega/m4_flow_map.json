          },
          "as": [
            "tlat",
            "tlon"
          ]
        },
        {
          "filter": "isValid(datum.tlat) && isValid(datum.olat)"
        },
        {
          "calculate": "datum.t == 'au' ? 'Australia' : 'Elsewhere'",
          "as": "dest"
        },
        {
          "calculate": "datum.n",
          "as": "reprints"
        },
        {
          "calculate": "datum.t",
          "as": "target_code"
        },
        {
          "calculate": "((datum.olon + 100 + 540) % 360) - 180",
          "as": "orl"
        },
        {
          "calculate": "((datum.tlon + 100 + 540) % 360) - 180",
          "as": "trl"
        },
        {
          "calculate": "log(tan(PI / 4 + datum.olat * PI / 360))",
          "as": "oy"
        },
        {
          "calculate": "log(tan(PI / 4 + datum.tlat * PI / 360))",
          "as": "ty"
        },
        {
          "calculate": "atan2(datum.oy - datum.ty, (datum.trl - datum.orl) * PI / 180) * 180 / PI",
          "as": "heading"
        },
        {
          "calculate": "focus == '' || datum.target_code == focus ? 1 : 0",
          "as": "lit"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "lit",
              "as": "any_lit"
            }
          ]
        }

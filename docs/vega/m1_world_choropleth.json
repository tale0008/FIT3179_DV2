{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "measure == 'Total' ? 'Comics published, in total (to 2026)' : 'Comics published per million people (to 2026)'"
    },
    "subtitle": [
      "Comic issues indexed in the Grand Comics Database, in total or",
      "divided by population. Colour uses a log scale: each step is roughly",
      "ten times the last."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "measure",
      "value": "Per million",
      "bind": {
        "input": "radio",
        "options": [
          "Per million",
          "Total"
        ],
        "labels": [
          "Per million people",
          "Total issues"
        ],
        "name": "Count "
      }
    },
    {
      "name": "zoom",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": [
          "World",
          "Europe"
        ],
        "name": "Zoom to "
      }
    },
    {
      "name": "focus",
      "value": ""
    },
    {
      "name": "zoomBase",
      "expr": "zoom == 'Europe' ? 4 : 1"
    },
    {
      "name": "zoomCentre",
      "expr": "zoom == 'Europe' ? [12, 52] : [0, 0]"
    },
    {
      "name": "zoomUnit",
      "expr": "width / 5.42"
    },
    {
      "name": "zoomK",
      "value": 1
    },
    {
      "name": "panX",
      "value": 0
    },
    {
      "name": "panY",
      "value": 0
    }
  ],
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "zoomBase * zoomK * zoomUnit"
    },
    "center": {
      "expr": "zoomCentre"
    },
    "translate": {
      "expr": "[width / 2 + panX, height / 2 + panY]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E3EDF3",
        "stroke": "#C9D9E3",
        "strokeWidth": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "iso_n3"
        },
        {
          "lookup": "iso_n3",
          "from": {
            "data": {
              "url": "data/country_meta.csv"
            },
            "key": "iso_n3",
            "fields": [
              "code",
              "country",
              "population"
            ]
          }
        },
        {
          "filter": "isValid(datum.code)"
        },
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/country_output.csv"
            },
            "key": "code",
            "fields": [
              "series",
              "issues",
              "issues_per_series"
            ]
          }
        },
        {
          "filter": "isValid(datum.issues)"
        },
        {
          "calculate": "datum.issues / (datum.population / 1000000)",
          "as": "per_million"
        },
        {
          "calculate": "measure == 'Total' ? datum.issues : datum.per_million",
          "as": "value"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "scheme": "purples",
            "nice": true
          },
          "legend": {
            "title": "Comic issues",
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 180,
            "format": ",.0f",
            "titleFontSize": 12,
            "labelFontSize": 12,
            "offset": 4
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "per_million",
            "type": "quantitative",
            "title": "Issues per million",
            "format": ",.0f"
          },
          {
            "field": "issues",
            "type": "quantitative",
            "title": "Issues indexed",
            "format": ","
          },
          {
            "field": "series",
            "type": "quantitative",
            "title": "Series",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "iso_n3"
        },
        {
          "lookup": "iso_n3",
          "from": {
            "data": {
              "url": "data/country_meta.csv"
            },
            "key": "iso_n3",
            "fields": [
              "code",
              "country",
              "population"
            ]
          }
        },
        {
          "filter": "isValid(datum.code)"
        },
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/country_output.csv"
            },
            "key": "code",
            "fields": [
              "series",
              "issues",
              "issues_per_series"
            ]
          }
        },
        {
          "filter": "isValid(datum.issues)"
        },
        {
          "calculate": "datum.issues / (datum.population / 1000000)",
          "as": "per_million"
        },
        {
          "calculate": "measure == 'Total' ? datum.issues : datum.per_million",
          "as": "value"
        },
        {
          "filter": "datum.code == focus"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "filled": false,
        "stroke": "#00B4D8",
        "strokeWidth": 2,
        "clip": true,
        "strokeJoin": "round"
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 6,
            "lat": 60,
            "label": [
              "Norway",
              "10,600"
            ]
          }
        ]
      },
      "transform": [
        {
          "filter": "measure != 'Total' && zoom == 'World'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "stroke": "#3a3833",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "datum": -40
            },
            "latitude2": {
              "datum": 47
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "dx": 0,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#3a3833",
            "lineHeight": 13,
            "dy": 2
          },
          "encoding": {
            "longitude": {
              "datum": -40
            },
            "latitude": {
              "datum": 47
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Comics published per million people",
    "subtitle": [
      "Comic issues indexed in the Grand Comics Database, divided by population.",
      "Colour uses a log scale: each step is roughly ten times the last."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "width": "container",
  "height": 280,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E3EDF3",
        "stroke": "#C9D9E3",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "iso_n3"
        },
        {
          "lookup": "iso_n3",
          "from": {
            "data": {
              "url": "data/country_meta.csv"
            },
            "key": "iso_n3",
            "fields": [
              "code",
              "country",
              "population"
            ]
          }
        },
        {
          "filter": "isValid(datum.code)"
        },
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/country_output.csv"
            },
            "key": "code",
            "fields": [
              "series",
              "issues",
              "issues_per_series"
            ]
          }
        },
        {
          "filter": "isValid(datum.issues)"
        },
        {
          "calculate": "datum.issues / (datum.population / 1000000)",
          "as": "per_million"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "per_million",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "scheme": "purples"
          },
          "legend": {
            "title": "Issues per million people",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 140,
            "format": ",.0f",
            "titleFontSize": 10,
            "labelFontSize": 9
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "per_million",
            "type": "quantitative",
            "title": "Issues per million",
            "format": ",.0f"
          },
          {
            "field": "issues",
            "type": "quantitative",
            "title": "Issues indexed",
            "format": ","
          },
          {
            "field": "series",
            "type": "quantitative",
            "title": "Series",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
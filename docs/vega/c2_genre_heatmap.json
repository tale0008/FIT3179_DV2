{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Every country has its favourite genre",
    "subtitle": [
      "Share of each country's indexed stories by genre. A story can",
      "carry more than one genre tag."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "focus",
      "value": ""
    }
  ],
  "data": {
    "url": "data/country_genre.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "stories",
          "as": "country_total"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.stories / datum.country_total",
      "as": "share"
    },
    {
      "filter": "datum.genre !== 'other'"
    },
    {
      "calculate": "({\"adventure\": \"Adventure\", \"anthropomorphic-funny animals\": \"Funny animals\", \"children\": \"Children\", \"crime\": \"Crime\", \"detective-mystery\": \"Mystery\", \"fantasy\": \"Fantasy\", \"horror-suspense\": \"Horror\", \"humor\": \"Humour\", \"non-fiction\": \"Non-fiction\", \"romance\": \"Romance\", \"science fiction\": \"Sci-fi\", \"superhero\": \"Superhero\", \"teen\": \"Teen\", \"war\": \"War\", \"western-frontier\": \"Western\"})[datum.genre]",
      "as": "genre"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "stories",
          "as": "genre_total"
        }
      ],
      "groupby": [
        "genre"
      ]
    },
    {
      "calculate": "datum.code == focus ? 1 : 0",
      "as": "is_focus"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "is_focus",
          "as": "focus_here"
        }
      ]
    }
  ],
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "encoding": {
    "x": {
      "field": "genre",
      "type": "nominal",
      "sort": {
        "field": "genre_total",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelAngle": -45,
        "labelAlign": "right",
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {
        "field": "country_total",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "domain": false,
        "ticks": false,
        "labelFontWeight": {
          "expr": "indexof(['Australia','Japan','United States'], datum.value) >= 0 ? 'bold' : 'normal'"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "scheme": "purples",
            "type": "sqrt"
          },
          "legend": {
            "title": "Share of country's stories",
            "format": ".0%",
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 140,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of stories",
            "format": ".1%"
          },
          {
            "field": "stories",
            "type": "quantitative",
            "title": "Stories",
            "format": ","
          }
        ],
        "opacity": {
          "condition": {
            "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(datum.country == 'Brazil' && datum.genre == 'Superhero') || (datum.country == 'Norway' && datum.genre == 'Humour')"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0%"
        },
        "opacity": {
          "condition": {
            "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
            "value": 1
          },
          "value": 0.25
        }
      }
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia prints other countries' comics. Japan prints its own.",
    "subtitle": [
      "Every 100 comic issues published in each country. Dark:",
      "reprints of foreign comics. Light: reprints of the country's",
      "own comics. Grey: no reprint recorded."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "focus",
      "value": ""
    }
  ],
  "data": {
    "url": "data/reprint_shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "total_issues": "number",
        "foreign_reprints": "number",
        "domestic_reprints": "number",
        "original": "number",
        "pct_foreign": "number",
        "pct_domestic": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "indexof(['au','us','jp'], datum.code) >= 0 || datum.code == focus"
    },
    {
      "calculate": "datum.code == focus && indexof(['au','us','jp'], datum.code) < 0 ? 3 : indexof(['au','us','jp'], datum.code)",
      "as": "ord"
    },
    {
      "calculate": "round(datum.pct_foreign)",
      "as": "f"
    },
    {
      "calculate": "round(datum.pct_domestic)",
      "as": "d"
    },
    {
      "calculate": "datum.country + '|' + format(datum.pct_foreign, '.1f') + '% foreign reprints|' + format(datum.pct_domestic, '.1f') + '% own reprints'",
      "as": "label"
    },
    {
      "calculate": "sequence(0, 100)",
      "as": "cells"
    },
    {
      "flatten": [
        "cells"
      ],
      "as": [
        "cell"
      ]
    },
    {
      "calculate": "datum.cell < datum.f ? 'foreign' : (datum.cell < datum.f + datum.d ? 'own' : 'none')",
      "as": "kind"
    },
    {
      "calculate": "(indexof(['au','us','jp'], datum.code) >= 0 ? datum.code : 'other') + '_' + datum.kind",
      "as": "key"
    },
    {
      "calculate": "datum.cell % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.cell / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.kind == 'foreign' ? 'Reprint of a foreign comic' : (datum.kind == 'own' ? 'Reprint of the country\\'s own comic' : 'No reprint recorded')",
      "as": "kind_label"
    },
    {
      "calculate": "datum.code == focus ? 1 : 0",
      "as": "is_focus"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "is_focus",
          "as": "focus_here"
        }
      ]
    }
  ],
  "facet": {
    "column": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "ord",
        "op": "min"
      },
      "header": {
        "labelExpr": "split(datum.value, '|')",
        "labelFontSize": 12,
        "labelAlign": "left",
        "labelAnchor": "start",
        "labelOrient": "top",
        "labelPadding": 6
      }
    }
  },
  "spacing": 18,
  "spec": {
    "width": 112,
    "height": 112,
    "mark": {
      "type": "rect",
      "stroke": "#ffffff",
      "strokeWidth": 1.5,
      "cornerRadius": 1,
      "cursor": "pointer"
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null
      },
      "color": {
        "field": "key",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": [
            "au_foreign",
            "au_own",
            "au_none",
            "us_foreign",
            "us_own",
            "us_none",
            "jp_foreign",
            "jp_own",
            "jp_none",
            "other_foreign",
            "other_own",
            "other_none"
          ],
          "range": [
            "#B07A00",
            "#DDC17F",
            "#E6E4DE",
            "#1F4E9A",
            "#93A8D1",
            "#E6E4DE",
            "#C8102E",
            "#EB9AA6",
            "#E6E4DE",
            "#6F6D66",
            "#B5B3AC",
            "#E6E4DE"
          ]
        }
      },
      "tooltip": [
        {
          "field": "country",
          "type": "nominal",
          "title": "Country"
        },
        {
          "field": "kind_label",
          "type": "nominal",
          "title": "This square"
        },
        {
          "field": "pct_foreign",
          "type": "quantitative",
          "title": "Foreign reprints (%)",
          "format": ".2f"
        },
        {
          "field": "pct_domestic",
          "type": "quantitative",
          "title": "Own reprints (%)",
          "format": ".2f"
        }
      ],
      "opacity": {
        "condition": {
          "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
          "value": 1
        },
        "value": 0.3
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia's comic boom ended decades ago",
    "subtitle": [
      "New series started per year, smoothed over five years and",
      "scaled to each country's own peak. Uncertain start years",
      "excluded."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "focus",
      "value": ""
    }
  ],
  "data": {
    "url": "data/country_year.csv"
  },
  "transform": [
    {
      "impute": "series",
      "key": "year",
      "keyvals": {
        "start": 1930,
        "stop": 2027,
        "step": 1
      },
      "groupby": [
        "country"
      ],
      "value": 0
    },
    {
      "window": [
        {
          "op": "mean",
          "field": "series",
          "as": "smoothed"
        }
      ],
      "frame": [
        -2,
        2
      ],
      "groupby": [
        "country"
      ],
      "sort": [
        {
          "field": "year",
          "order": "ascending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "smoothed",
          "as": "peak"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.smoothed / datum.peak",
      "as": "norm"
    },
    {
      "calculate": "datum.year * datum.series",
      "as": "year_weight"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "year_weight",
          "as": "sum_yw"
        },
        {
          "op": "sum",
          "field": "series",
          "as": "total"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "round(datum.sum_yw / datum.total)",
      "as": "avg_year"
    },
    {
      "calculate": "indexof(['Australia','Japan','United States'], datum.country) >= 0 ? datum.country : 'Other countries'",
      "as": "highlight"
    },
    {
      "calculate": "datum.code == focus ? 1 : 0",
      "as": "is_focus"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "is_focus",
          "as": "focus_here"
        }
      ]
    }
  ],
  "facet": {
    "row": {
      "field": "country",
      "type": "nominal",
      "sort": {
        "field": "avg_year",
        "op": "min",
        "order": "ascending"
      },
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelFontSize": 12,
        "labelPadding": 6,
        "labelFontWeight": {
          "expr": "indexof(['Australia','Japan','United States'], datum.value) >= 0 ? 'bold' : 'normal'"
        }
      }
    }
  },
  "spec": {
    "width": 420,
    "height": 22,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "stroke": "#ffffff",
          "strokeWidth": 0.6,
          "cursor": "pointer"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [
                1930,
                2026
              ],
              "nice": false
            },
            "axis": {
              "title": null,
              "format": "d",
              "grid": false,
              "tickCount": 10
            }
          },
          "y": {
            "field": "norm",
            "type": "quantitative",
            "scale": {
              "range": [
                22,
                -22
              ]
            },
            "axis": null
          },
          "tooltip": [
            {
              "field": "country",
              "type": "nominal",
              "title": "Country"
            },
            {
              "field": "year",
              "type": "quantitative",
              "title": "Year",
              "format": "d"
            },
            {
              "field": "series",
              "type": "quantitative",
              "title": "Series started"
            },
            {
              "field": "avg_year",
              "type": "quantitative",
              "title": "Average year",
              "format": "d"
            }
          ],
          "color": {
            "condition": {
              "test": "datum.code == focus && datum.highlight == 'Other countries'",
              "value": "#6F6D66"
            },
            "field": "highlight",
            "type": "nominal",
            "scale": {
              "domain": [
                "Australia",
                "Japan",
                "United States",
                "Other countries"
              ],
              "range": [
                "#B07A00",
                "#C8102E",
                "#1F4E9A",
                "#C9C9C4"
              ]
            },
            "legend": null
          },
          "fillOpacity": {
            "condition": {
              "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
              "value": 0.9
            },
            "value": 0.2
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.country == 'Australia' && datum.year == 1989"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "bottom",
          "fontSize": 11,
          "color": "#2B2B28",
          "dy": -16,
          "lineHeight": 13
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "value": 22
          },
          "text": {
            "value": [
              "Almost no new series",
              "since the mid-1980s"
            ]
          }
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 0
    }
  }
}
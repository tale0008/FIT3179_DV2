{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Importers and self-reprinters",
    "subtitle": [
      "Share of each country's comic issues that reprint foreign comics (right)",
      "or the country's own comics (left). Countries with over 5,000 issues indexed."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "data": {
    "url": "data/reprint_shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "total_issues": "number",
        "foreign_reprints": "number",
        "domestic_reprints": "number",
        "original": "number",
        "pct_foreign": "number",
        "pct_domestic": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "replace(replace(datum.country, ' (Hrvatska)', ''), ' (1918-1991)', '')",
      "as": "name"
    },
    {
      "fold": [
        "pct_foreign",
        "pct_domestic"
      ],
      "as": [
        "measure",
        "pct"
      ]
    },
    {
      "calculate": "datum.measure == 'pct_foreign' ? 'foreign' : 'own'",
      "as": "side"
    },
    {
      "calculate": "datum.side == 'own' ? -datum.pct : datum.pct",
      "as": "signed"
    },
    {
      "calculate": "(indexof(['Australia','Japan','United States'], datum.country) >= 0 ? datum.code : 'other') + '_' + datum.side",
      "as": "key"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "pct_foreign",
          "as": "sort_foreign"
        }
      ],
      "groupby": [
        "name"
      ]
    }
  ],
  "width": "container",
  "height": {
    "step": 20
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "encoding": {
    "y": {
      "field": "name",
      "type": "nominal",
      "sort": {
        "field": "sort_foreign",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "domain": false,
        "ticks": false,
        "labelFontWeight": {
          "expr": "indexof(['Australia','Japan','United States'], datum.value) >= 0 ? 'bold' : 'normal'"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2,
        "height": {
          "band": 0.8
        }
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              45
            ]
          },
          "axis": {
            "title": "← own comics (%)     foreign comics (%) →",
            "labelExpr": "abs(datum.value)",
            "titleFontSize": 10,
            "titleFontWeight": "normal",
            "labelFontSize": 9,
            "grid": true,
            "gridColor": "#ECEBE6",
            "tickCount": 8,
            "domain": false
          }
        },
        "color": {
          "field": "key",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "au_foreign",
              "au_own",
              "us_foreign",
              "us_own",
              "jp_foreign",
              "jp_own",
              "other_foreign",
              "other_own"
            ],
            "range": [
              "#B07A00",
              "#DDC17F",
              "#1F4E9A",
              "#93A8D1",
              "#C8102E",
              "#EB9AA6",
              "#A6A5A0",
              "#D3D2CC"
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "side",
            "type": "nominal",
            "title": "Reprints of"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share of issues (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#2B2B28",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(indexof(['Australia','Japan','United States'], datum.country) >= 0 && ((datum.side == 'foreign' && datum.code == 'au') || (datum.side == 'own' && datum.code != 'au'))) && datum.signed >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2B2B28",
        "align": "left",
        "dx": 4
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(indexof(['Australia','Japan','United States'], datum.country) >= 0 && ((datum.side == 'foreign' && datum.code == 'au') || (datum.side == 'own' && datum.code != 'au'))) && datum.signed < 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2B2B28",
        "align": "right",
        "dx": -4
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
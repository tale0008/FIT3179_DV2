{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australians buy more comics every year. They make almost none.",
    "subtitle": [
      "Two different counts for the same four years: copies sold",
      "in Australian shops, and new comic series made in Australia."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "spacing": 28,
  "resolve": {
    "scale": {
      "x": "independent",
      "xOffset": "independent"
    }
  },
  "vconcat": [
    {
      "title": {
        "text": "Graphic novels sold in Australian shops",
        "subtitle": "Copies. Excludes manga and superhero titles. Source: NielsenIQ BookScan.",
        "anchor": "start",
        "fontSize": 13,
        "fontWeight": "bold",
        "subtitleFontSize": 13,
        "subtitleColor": "#555",
        "offset": 10
      },
      "data": {
        "url": "data/au_sales.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "units": "number"
          }
        }
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "units",
              "as": "total"
            }
          ],
          "groupby": [
            "year"
          ]
        }
      ],
      "width": 400,
      "height": 140,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#8C8B85",
            "cornerRadiusEnd": 3,
            "width": {
              "band": 0.6
            }
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "scale": {
                "domain": [
                  2020,
                  2021,
                  2022,
                  2023
                ],
                "paddingInner": 0.35,
                "type": "band"
              },
              "axis": {
                "title": null,
                "labelAngle": 0,
                "domain": false,
                "ticks": false,
                "labelPadding": 6
              }
            },
            "y": {
              "field": "total",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1600000
                ]
              },
              "axis": null
            },
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "total",
                "type": "quantitative",
                "title": "Graphic novels sold",
                "format": ","
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -6,
            "fontSize": 12,
            "baseline": "bottom",
            "color": "#2B2B28"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "scale": {
                "domain": [
                  2020,
                  2021,
                  2022,
                  2023
                ],
                "paddingInner": 0.35,
                "type": "band"
              },
              "axis": {
                "title": null,
                "labelAngle": 0,
                "domain": false,
                "ticks": false,
                "labelPadding": 6
              }
            },
            "y": {
              "field": "total",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  1600000
                ]
              },
              "axis": null
            },
            "text": {
              "field": "total",
              "type": "quantitative",
              "format": ".2s"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "New comic series made in Australia",
        "subtitle": "Series started each year. Source: Grand Comics Database.",
        "anchor": "start",
        "fontSize": 13,
        "fontWeight": "bold",
        "subtitleFontSize": 13,
        "subtitleColor": "#555",
        "offset": 10
      },
      "data": {
        "url": "data/au_series_by_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "series": "number",
            "issues": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year >= 2020 && datum.year <= 2023"
        },
        {
          "impute": "series",
          "key": "year",
          "keyvals": [
            2020,
            2021,
            2022,
            2023
          ],
          "value": 0
        }
      ],
      "width": 400,
      "height": 60,
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.series > 0"
            },
            {
              "calculate": "sequence(0, datum.series)",
              "as": "cells"
            },
            {
              "flatten": [
                "cells"
              ],
              "as": [
                "cell"
              ]
            },
            {
              "calculate": "datum.cell - (datum.series - 1) / 2",
              "as": "off"
            }
          ],
          "mark": {
            "type": "square",
            "size": 40,
            "color": "#B07A00",
            "opacity": 1
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "scale": {
                "domain": [
                  2020,
                  2021,
                  2022,
                  2023
                ],
                "paddingInner": 0.35,
                "type": "band"
              },
              "axis": {
                "title": null,
                "labelAngle": 0,
                "domain": false,
                "ticks": false,
                "labelPadding": 6
              }
            },
            "xOffset": {
              "field": "off",
              "type": "quantitative",
              "scale": {
                "domain": [
                  -4,
                  4
                ]
              }
            },
            "y": {
              "value": 16
            },
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "series",
                "type": "quantitative",
                "title": "New Australian series"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.series + ' new series'",
              "as": "lab"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#2B2B28",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "scale": {
                "domain": [
                  2020,
                  2021,
                  2022,
                  2023
                ],
                "paddingInner": 0.35,
                "type": "band"
              }
            },
            "y": {
              "value": 44
            },
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two ways to publish comics",
    "subtitle": [
      "Both axes use a log scale. Countries with at least 200 series indexed."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "params": [
    {
      "name": "focus",
      "value": ""
    }
  ],
  "data": {
    "url": "data/country_output.csv",
    "format": {
      "type": "csv",
      "parse": {
        "series": "number",
        "issues": "number",
        "issues_per_series": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.series >= 200"
    },
    {
      "calculate": "replace(replace(datum.country, ' (Hrvatska)', ''), ' (1918-1991)', '')",
      "as": "name"
    },
    {
      "calculate": "indexof(['Australia','Japan','United States'], datum.country) >= 0 ? datum.country : 'Other countries'",
      "as": "highlight"
    },
    {
      "calculate": "datum.code == focus ? 1 : 0",
      "as": "is_focus"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "is_focus",
          "as": "focus_here"
        }
      ]
    }
  ],
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "encoding": {
    "x": {
      "field": "series",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          150,
          150000
        ]
      },
      "axis": {
        "title": "Comic series published (log scale)",
        "format": "~s",
        "titleFontSize": 12,
        "titleFontWeight": "normal",
        "gridColor": "#ECEBE6",
        "domain": false,
        "values": [
          1000,
          10000,
          100000
        ]
      }
    },
    "y": {
      "field": "issues_per_series",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          2,
          200
        ]
      },
      "axis": {
        "title": "Average issues per series (log scale)",
        "titleFontSize": 12,
        "titleFontWeight": "normal",
        "gridColor": "#ECEBE6",
        "domain": false,
        "values": [
          2,
          5,
          10,
          20,
          50,
          100,
          200
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.code == focus && datum.highlight == 'Other countries'",
            "value": "#6F6D66"
          },
          "field": "highlight",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Australia",
              "Japan",
              "United States",
              "Other countries"
            ],
            "range": [
              "#B07A00",
              "#C8102E",
              "#1F4E9A",
              "#A6A5A0"
            ]
          }
        },
        "order": {
          "condition": {
            "test": "datum.code == focus || datum.highlight != 'Other countries'",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "series",
            "type": "quantitative",
            "title": "Series",
            "format": ","
          },
          {
            "field": "issues",
            "type": "quantitative",
            "title": "Issues",
            "format": ","
          },
          {
            "field": "issues_per_series",
            "type": "quantitative",
            "title": "Issues per series",
            "format": ".1f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "country",
            "oneOf": [
              "Mexico",
              "Argentina",
              "Philippines",
              "Japan",
              "Australia",
              "United States",
              "France",
              "United Kingdom",
              "Belgium"
            ]
          }
        },
        {
          "filter": "indexof(['Australia','Japan','United States'], datum.country) < 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 12,
        "color": "#2B2B28"
      },
      "encoding": {
        "text": {
          "field": "name"
        },
        "opacity": {
          "condition": {
            "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
            "value": 1
          },
          "value": 0.35
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "country",
            "oneOf": [
              "Mexico",
              "Argentina",
              "Philippines",
              "Japan",
              "Australia",
              "United States",
              "France",
              "United Kingdom",
              "Belgium"
            ]
          }
        },
        {
          "filter": "indexof(['Australia','Japan','United States'], datum.country) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 12,
        "color": "#2B2B28",
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "name"
        },
        "opacity": {
          "condition": {
            "test": "focus == '' || datum.focus_here == 0 || datum.code == focus",
            "value": 1
          },
          "value": 0.35
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.code == focus && indexof(['Mexico', 'Argentina', 'Philippines', 'Japan', 'Australia', 'United States', 'France', 'United Kingdom', 'Belgium'], datum.country) < 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#2B2B28"
      },
      "encoding": {
        "text": {
          "field": "name"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "series": 170,
            "issues_per_series": 170,
            "t": "Few series, each running for a very long time",
            "a": "left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#5F5E58",
        "align": "left"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "series": 140000,
            "issues_per_series": 2.3,
            "t": "Many series, each running a short time",
            "a": "right"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#5F5E58",
        "align": "right"
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who manga is written for",
    "subtitle": [
      "New manga series by start year and intended audience, among",
      "the 5,000 most popular manga on MyAnimeList (data as of August",
      "2023). Three-year average. Shōnen and shōjo are aimed at teen",
      "boys and girls, seinen and josei at adult men and women."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "data": {
    "url": "data/manga_demo_by_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "titles": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 1970 && datum.year <= 2022"
    },
    {
      "window": [
        {
          "op": "mean",
          "field": "titles",
          "as": "smooth"
        }
      ],
      "frame": [
        -1,
        1
      ],
      "groupby": [
        "demographic"
      ],
      "sort": [
        {
          "field": "year"
        }
      ]
    },
    {
      "calculate": "indexof([\"Sh\\u014dnen\", \"Sh\\u014djo\", \"Seinen\", \"Josei\", \"Kids\", \"Not stated\"], datum.demographic)",
      "as": "ord"
    }
  ],
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1970,
          2022
        ],
        "nice": false
      },
      "axis": {
        "titleFontSize": 12,
        "titleFontWeight": "normal",
        "labelFontSize": 12,
        "gridColor": "#ECEBE6",
        "domain": false,
        "ticks": false,
        "title": null,
        "format": "d",
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "basis",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "y": {
          "field": "smooth",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "demographic",
          "type": "nominal",
          "scale": {
            "domain": [
              "Shōnen",
              "Shōjo",
              "Seinen",
              "Josei",
              "Kids",
              "Not stated"
            ],
            "range": [
              "#2D6A1F",
              "#A9CF7F",
              "#0E8C8C",
              "#86D3CE",
              "#A6A5A0",
              "#DAD9D3"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "columns": 6,
            "labelFontSize": 12,
            "symbolType": "square",
            "titleLimit": 0,
            "labelLimit": 0
          }
        },
        "order": {
          "field": "ord"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Start year",
            "format": "d"
          },
          {
            "field": "demographic",
            "type": "nominal",
            "title": "Audience"
          },
          {
            "field": "titles",
            "type": "quantitative",
            "title": "New series that year"
          }
        ],
        "opacity": {
          "condition": {
            "param": "audience",
            "value": 1
          },
          "value": 0.2
        }
      },
      "params": [
        {
          "name": "audience",
          "select": {
            "type": "point",
            "fields": [
              "demographic"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "transform": [
        {
          "stack": "smooth",
          "groupby": [
            "year"
          ],
          "sort": [
            {
              "field": "ord"
            }
          ],
          "offset": "center",
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "mid"
        },
        {
          "filter": "indexof(['Shōnen','Shōjo','Seinen','Josei'], datum.demographic) >= 0 && datum.year >= 1976 && datum.year <= 2016"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "groupby": [
            "demographic"
          ],
          "sort": [
            {
              "field": "smooth",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "demographic"
        },
        "color": {
          "condition": {
            "test": "datum.demographic == 'Shōnen' || datum.demographic == 'Seinen'",
            "value": "#ffffff"
          },
          "value": "#1f1e1b"
        },
        "opacity": {
          "condition": {
            "param": "audience",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        }
      }
    }
  ]
}
  "title": {
    "text": "Where American comic creators were born",
    "subtitle": [
      "Comic creators by birth state, in total and per million",
      "residents (US Census Bureau 2024 estimates). Only creators",
      "with a recorded birth state in the Grand Comics Database are",
      "counted."
    ],
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": 340,

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "When each country made comics",
    "subtitle": "New series started per year, 1930-2026. Uncertain start years excluded.",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "subtitleColor": "#666"
  },
  "data": {"url": "data/country_year.csv"},
  "transform": [
    {
      "impute": "series",
      "key": "year",
      "keyvals": {"start": 1930, "stop": 2027, "step": 1},
      "groupby": ["country"],
      "value": 0
    },
    {
      "window": [{"op": "mean", "field": "series", "as": "smoothed"}],
      "frame": [-2, 2],
      "groupby": ["country"],
      "sort": [{"field": "year"}]
    },
    {
      "joinaggregate": [{"op": "max", "field": "smoothed", "as": "peak"}],
      "groupby": ["country"]
    },
    {"calculate": "datum.smoothed / datum.peak", "as": "norm"},
    {
      "joinaggregate": [{"op": "sum", "field": "series", "as": "total"}],
      "groupby": ["country"]
    }
  ],
  "width": "container",
  "height": 26,
  "bounds": "flush",
  "spacing": 2,
  "facet": {
    "row": {
      "field": "country",
      "type": "nominal",
      "sort": {"op": "max", "field": "total", "order": "descending"},
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelAnchor": "middle",
        "labelFontSize": 10,
        "labelPadding": 4
      }
    }
  },
  "spec": {
    "width": "container",
    "height": 26,
    "layer": [
      {
        "mark": {"type": "area", "interpolate": "monotone", "fillOpacity": 0.75, "line": {"strokeWidth": 1}},
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {"domain": [1930, 2026], "nice": false},
            "axis": {"title": null, "format": "d", "grid": false, "tickCount": 10}
          },
          "y": {
            "field": "norm",
            "type": "quantitative",
            "scale": {"domain": [0, 1]},
            "axis": null
          },
          "color": {
            "field": "country",
            "type": "nominal",
            "scale": {"scheme": "tableau20"},
            "legend": null
          },
          "tooltip": [
            {"field": "country", "type": "nominal", "title": "Country"},
            {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
            {"field": "series", "type": "quantitative", "title": "Series started"}
          ]
        }
      }
    ]
  },
  "config": {
    "view": {"stroke": null},
    "facet": {"spacing": 2},
    "font": "Inter, system-ui, sans-serif"
  }
}
